# Copy to .release.env (gitignored) to cut releases without a passphrase prompt.
#
# scripts/release.ps1 uses this for exactly one thing: loading the signing key
# into ssh-agent via `ssh-add`. Git has no passphrase environment variable --
# ssh-agent is the supported way to sign unattended -- so the value never
# reaches git, only OpenSSH, and only through a temporary askpass helper that
# is deleted immediately after.
#
# The key is unlocked once per agent session. If you would rather not keep the
# passphrase on disk, delete this file and run `ssh-add ~/.ssh/marvi_release_signing`
# yourself once per boot; release.ps1 detects an already-loaded key and skips
# the whole step.
MARVI_SIGNING_PASSPHRASE=
