    { "providers": ["openai", "openai-responses"], "pattern": "gpt-5*", "efforts": ["minimal", "low", "medium", "high"] },
    { "providers": ["openai", "openai-responses"], "pattern": "o3-pro*", "efforts": ["high"] },
    { "providers": ["openai", "openai-responses"], "pattern": "o3-mini*", "efforts": ["low", "medium", "high"] },
