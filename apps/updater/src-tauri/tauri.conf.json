{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marvi Bootstrap",
  "version": "0.1.0",
  "identifier": "ai.neuretro.marvi-bootstrap",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Marvi Bootstrap",
        "width": 720,
        "height": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "alwaysOnTop": false,
        "minimizable": true,
        "maximizable": false,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
