{
  "name": "marvi-os-desktop",
  "version": "0.6.1",
  "description": "Always-on voice and vision shell for Marvi OS",
  "main": "./out/main/index.js",
  "author": "NeuRetro Research",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build:pet-host": "cargo build --release --manifest-path ../pet-host/Cargo.toml",
    "build:wake-host": "cargo build --release --manifest-path ../wake-host/Cargo.toml",
    "build": "npm run build:pet-host && npm run build:wake-host && npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@thesvg/react": "^3.3.1",
    "d3-force": "^3.0.0",
    "katex": "^0.16.22",
    "lucide-react": "0.577.0",
    "mdast-util-to-string": "^4.0.0",
    "pixi.js": "^8.19.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@nanostores/react": "^1.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "livekit-client": "^2.15.10",
    "nanostores": "^1.0.1",
    "prettier": "^3.7.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "unicode-animations": "^1.0.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18",
    "web-haptics": "^0.0.6"
  }
}
